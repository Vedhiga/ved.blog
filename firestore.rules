rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /posts/{postId} {
      // Anyone can read posts
      allow read: if true;

      // Only a signed-in admin (you) can create/edit/delete posts
      allow create, delete: if request.auth != null;

      // Allow authenticated edits, OR anonymous like-count increments only
      allow update: if request.auth != null
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
          && request.resource.data.likes is int
          && (request.resource.data.likes == resource.data.likes + 1
              || request.resource.data.likes == resource.data.likes - 1)
        );

      match /comments/{commentId} {
        // Anyone can read comments
        allow read: if true;

        // Anyone can post a comment, with basic validation (poor-man's rate limit /
        // spam guard: bounded length, required fields, server timestamp)
        allow create: if request.resource.data.keys().hasAll(['name','text','createdAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time;

        // Only admin can delete/edit comments (moderation)
        allow update, delete: if request.auth != null;
      }
    }
  }
}
